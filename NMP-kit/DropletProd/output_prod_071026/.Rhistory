"1 direction (+z)" = "moving_1dir.dat")   # edit names/labels to match what you have
cols   <- c("black", "firebrick")
read_one <- function(f) read.table(f, comment.char = "#", col.names = c("d", "count", "rho"))
dat <- lapply(files, read_one)
