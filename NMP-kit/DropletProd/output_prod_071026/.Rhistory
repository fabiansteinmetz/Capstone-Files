d <- read.table("moving_sphere_density.dat", comment.char = "#", col.names = c("d", "count", "rho"))
rho_ref <- d$rho[1]                      # d = 0, should be ~0.98
d90 <- d$d[which(d$rho < 0.9 * rho_ref)[1]]
r0 <- 20
R_int <- d90 + 0.61 * r0                 # sharp-interface correction (10% of the sphere volume outside)
cat(sprintf("rho_ref = %.3f, d90 = %.1f A, interface at R ~ %.1f A\n", rho_ref, d90, R_int))
r0 <- 20   # sphere radius used in the script (Å)
